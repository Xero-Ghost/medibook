{
  "name": "medibook",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "npm run build --workspace frontend",
    "dev:api": "npm run dev --workspace backend",
    "dev:web": "npm run dev --workspace frontend",
    "start": "npm start --workspace backend",
    "test": "node --test backend/test/*.test.js",
    "seed": "npm run seed --workspace backend",
    "create-admin": "npm run create-admin --workspace backend"
  },
  "devDependencies": {
    "mongodb-memory-server-core": "^11.3.0"
  }
}
